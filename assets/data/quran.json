{
  "surahs": [
    {
      "number": 1,
      "name": "الفاتحه",
      "ayahs": [
        {
          "number": 1,
          "text_ar": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",
          "text_fa": "به نام خداوند بخشنده مهربان"
        },
        {
          "number": 2,
          "text_ar": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",
          "text_fa": "همه ستایش مخصوص خداوند، پروردگار جهانیان است"
        },
        {
          "number": 3,
          "text_ar": "الرَّحْمَٰنِ الرَّحِيمِ",
          "text_fa": "بخشندهٔ مهربان"
        },
        {
          "number": 4,
          "text_ar": "مَالِكِ يَوْمِ الدِّينِ",
          "text_fa": "مالک روز جزا"
        },
        {
          "number": 5,
          "text_ar": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
          "text_fa": "تنها تو را می‌پرستیم و تنها از تو یاری می‌جوییم"
        },
        {
          "number": 6,
          "text_ar": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ",
          "text_fa": "ما را به راه راست هدایت کن"
        },
        {
          "number": 7,
          "text_ar": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ",
          "text_fa": "راه کسانی که به آنان نعمت داده‌ای؛ نه راه کسانی که مورد خشم‌اند و نه گمراهان"
        }
      ]
    },
    {
      "number": 112,
      "name": "الإخلاص",
      "ayahs": [
        {
          "number": 1,
          "text_ar": "قُلْ هُوَ اللَّهُ أَحَدٌ",
          "text_fa": "بگو او خداوند یکتا است"
        },
        {
          "number": 2,
          "text_ar": "اللَّهُ الصَّمَدُ",
          "text_fa": "خداوند بی‌نیاز (و تکیه‌گاه همه) است"
        },
        {
          "number": 3,
          "text_ar": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
          "text_fa": "نه زاییده شده و نه زاینده است"
        },
        {
          "number": 4,
          "text_ar": "وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ",
          "text_fa": "و هیچ‌کس همتا و مانند او نیست"
        }
      ]
    },
    {
      "number": 113,
      "name": "الفلق",
      "ayahs": [
        {
          "number": 1,
          "text_ar": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ",
          "text_fa": "بگو پناه می‌برم به پروردگار سپیده‌دم"
        },
        {
          "number": 2,
          "text_ar": "مِن شَرِّ مَا خَلَقَ",
          "text_fa": "از شر آنچه آفریده است"
        },
        {
          "number": 3,
          "text_ar": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
          "text_fa": "و از شر تاریکی هنگامی که فراگیرد"
        },
        {
          "number": 4,
          "text_ar": "وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ",
          "text_fa": "و از شر زنان ساحره که در گره‌ها نفوذ می‌کنند"
        },
        {
          "number": 5,
          "text_ar": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
          "text_fa": "و از شر حسود هنگامی که حسد ورزد"
        }
      ]
    }
  ]
}
